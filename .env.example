# Monitoring stack environment — copy to `.env` and fill in.
# `.env` is gitignored; never commit real secret values.

# Grafana admin
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Alertmanager Telegram routing
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SiteLedger production PostgreSQL exporter
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Project Sam (personal-ai-companion) PostgreSQL exporter
SAM_POSTGRES_USER=
SAM_POSTGRES_PASSWORD=
SAM_POSTGRES_DB=
