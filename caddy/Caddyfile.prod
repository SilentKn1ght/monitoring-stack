# ============================================================================
# Caddyfile â€” PRODUCTION
# ============================================================================
# Replaces app-nginx-1 as the ingress. Behaviour is an itemised port of that
# container's EFFECTIVE config (/tmp/nginx.conf, generated by nginx-entrypoint.sh
# via envsubst â€” NOT /etc/nginx/nginx.conf, which is inert).
#
# Certificates are mounted read-only from /opt/siteledger/app/nginx/certs, where
# acme.sh installs them. acme.sh stays the SOLE ACME owner; Caddy never contacts
# Let's Encrypt, ZeroSSL or DuckDNS. Because every site names its certificate
# files explicitly, Caddy performs no ACME at all.
#
# Rate limiting preserves nginx's two zones:
#   /api/auth/login  -> 5 requests / 1 minute
#   /api/*           -> 30 requests / 1 second
# nginx uses a leaky bucket with a separate burst allowance; this is a fixed
# window, and both values are set AT OR BELOW nginx's effective ceiling, so
# protection is never weakened. nginx answers 503 when limiting; Caddy answers
# 429, which the SiteLedger frontend already handles explicitly.
# ============================================================================

{
	# Admin API, bound to the CONTAINER'S OWN LOOPBACK ONLY and never published,
	# so nothing outside the container can reach it. It is kept enabled for
	# operational config reloads only.
	#
	# It is NOT what picks up a renewed certificate. Caddy caches PEM certs by
	# path, and `caddy reload` does not re-read them - proven by swapping the
	# file and reloading, after which Caddy still served the old certificate.
	# Renewal therefore relies on the acme.sh Le_ReloadCmd, which is
	# `docker restart caddy-migration-caddy-1`. See certificates.md.
	admin localhost:2019

	# Only trust proxy headers from private ranges, so a client cannot spoof
	# X-Forwarded-For and evade the rate limiter.
	servers {
		trusted_proxies static private_ranges
	}
}

# ===========================================================================
# ACME HTTP-01 challenge â€” plain HTTP, never redirected
# ===========================================================================
# acme.sh validates samstats.duckdns.org with HTTP-01 against this directory.
# It has to be reachable over HTTP without a redirect, so it is declared as its
# own :80 site rather than falling through to the redirect below. Serving a
# well-known path is not a content route.
:80 {
	root * /acme-webroot
	handle /.well-known/acme-challenge/* {
		file_server
	}
	handle {
		redir https://{host}{uri} 308
	}
}

# ===========================================================================
# Snippet: the SiteLedger production site body, shared by the named host and
# the catch-all.
# ===========================================================================
(production_site) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Resource-Policy "cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}

	encode zstd gzip

	@login path /api/auth/login
	handle @login {
		rate_limit {
			zone login {
				key    {http.request.remote.host}
				events 5
				window 1m
			}
		}
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle /api/* {
		rate_limit {
			zone api {
				key    {http.request.remote.host}
				events 30
				window 1s
			}
		}
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle /grafana/api/live/* {
		reverse_proxy grafana:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
		}
	}

	handle /grafana/* {
		reverse_proxy grafana:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	handle {
		root * /srv
		try_files {path} {path}/ /index.html
		file_server
	}
}

# ===========================================================================
# Sam Control Center â€” samstats.duckdns.org
# ===========================================================================
# Both upstreams are reached over Docker DNS, not through published host ports:
#   sam-control-center:8080  the static PWA
#   sam-backend:8000         the API (auth + read-only observability)
# Both containers are on the `monitoring` network, which Caddy joins. Neither is
# published on a public interface, so this vhost is the only way in.
#
# Only the Control Center's own routes are proxied. The backend's legacy chat
# routes are guarded by nothing but an X-User-Id UUID and are deliberately NOT
# exposed. An allow-list is used rather than a deny-list so a newly added
# backend route cannot be published by accident.
samstats.duckdns.org {
	tls /certs/samstats-fullchain.pem /certs/samstats-privkey.pem

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	encode zstd gzip

	request_body {
		max_size 12MB
	}

	# --- operator sign-in: password then TOTP ---
	handle /api/control-center/* {
		rate_limit {
			zone cc_auth {
				key    {http.request.remote.host}
				events 30
				window 1s
			}
		}
		# Strip exactly /api. handle_path would strip the whole matched
		# prefix (/api/control-center) and produce /auth/session, which is
		# not a backend route.
		uri strip_prefix /api
		reverse_proxy sam-backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
		}
	}

	# --- read-only observability ---
	handle /api/observability/* {
		rate_limit {
			zone cc_api {
				key    {http.request.remote.host}
				events 60
				window 1s
			}
		}
		uri strip_prefix /api
		reverse_proxy sam-backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
			transport http {
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# Any other /api path is a 404, not a pass-through.
	handle /api/* {
		respond "Not found" 404
	}

	# --- the PWA ---
	handle {
		reverse_proxy sam-control-center:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
		}
	}
}

# ===========================================================================
# Catch-all â€” parity with nginx `server_name _`
# ===========================================================================
# REQUIRED. SiteLedger's deploy.sh verifies `https://localhost/api/health`, and
# nginx matched any Host because of `server_name _`; Caddy matches exact
# hostnames, so without this block that check 404s and the deploy aborts.
#
# Any OTHER unknown hostname gets 421 instead of the production app, so a stray
# Host header cannot pull the production UI off this ingress. Previously the
# catch-all served the SiteLedger certificate and UI for every hostname, which
# is what made samstats.duckdns.org present a mismatched certificate.
:443 {
	tls /certs/fullchain.pem /certs/privkey.pem

	@known host siteledger.duckdns.org siteledgerstaging.duckdns.org samstats.duckdns.org localhost 127.0.0.1
	handle @known {
		import production_site
	}

	respond "Misdirected Request" 421
}

# ===========================================================================
# SiteLedger â€” staging (parity of certs/vhosts/staging.conf: 4 headers only)
# ===========================================================================
siteledgerstaging.duckdns.org {
	tls /certs/staging-fullchain.pem /certs/staging-privkey.pem

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		rate_limit {
			zone staging_api {
				key    {http.request.remote.host}
				events 30
				window 1s
			}
		}
		request_body {
			max_size 12MB
		}
		reverse_proxy staging-frontend:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy staging-frontend:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			header_up X-Forwarded-Proto https
		}
	}
}