{
  "title": "Docker and system monitoring",
  "uid": "aft3eody4qcxsb",
  "tags": ["docker", "system", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "description": "Docker host and container metrics overview",
  "panels": [
    {
      "id": 24, "title": "Uptime", "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "time() - node_boot_time_seconds{instance=~\"$server\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 31, "title": "Containers", "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "count(up{job=~\"applications|node-exporter\"})", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}}
    },
    {
      "id": 26, "title": "Disk Space", "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"})) * 100", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 25, "title": "Memory", "type": "gauge",
      "gridPos": {"h": 6, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$server\"} / node_memory_MemTotal_bytes{instance=~\"$server\"})) * 100", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 30, "title": "Swap", "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "(node_memory_SwapTotal_bytes{instance=~\"$server\"} - node_memory_SwapFree_bytes{instance=~\"$server\"})", "legendFormat": "used", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 27, "title": "Load", "type": "stat",
      "gridPos": {"h": 6, "w": 4, "x": 20, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "node_load1{instance=~\"$server\"} / count(node_cpu_seconds_total{mode=\"system\",instance=~\"$server\"}) by (instance)", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "id": 19, "title": "Network Traffic", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\",instance=~\"$server\"}[$__rate_interval]))", "legendFormat": "Received", "refId": "A"},
        {"expr": "sum(rate(node_network_transmit_bytes_total{device!=\"lo\",instance=~\"$server\"}[$__rate_interval]))", "legendFormat": "Sent", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 5, "title": "CPU Usage", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$server\"}[$__rate_interval])) * 100)", "legendFormat": "CPU", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 28, "title": "System Load", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "node_load1{instance=~\"$server\"} / count(node_cpu_seconds_total{mode=\"system\",instance=~\"$server\"}) by (instance)", "legendFormat": "Load", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}}
    },
    {
      "id": 13, "title": "Used Disk Space", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "node_filesystem_size_bytes{fstype=~\"ext4|xfs\",instance=~\"$server\",mountpoint=\"/\"} - node_filesystem_free_bytes{fstype=~\"ext4|xfs\",instance=~\"$server\",mountpoint=\"/\"}", "legendFormat": "Used", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 20, "title": "Available Memory", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [{"expr": "node_memory_MemTotal_bytes{instance=~\"$server\"} - node_memory_MemAvailable_bytes{instance=~\"$server\"}", "legendFormat": "Used", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 3, "title": "Disk I/O", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total{instance=~\"$server\"}[$__rate_interval])", "legendFormat": "Read {{device}}", "refId": "A"},
        {"expr": "rate(node_disk_written_bytes_total{instance=~\"$server\"}[$__rate_interval])", "legendFormat": "Write {{device}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    }
  ],
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}},
    {"name": "server", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "query": "label_values(up{job=\"node-exporter\"}, instance)", "multi": false, "includeAll": false,
     "current": {"text": "node-exporter:9100", "value": "node-exporter:9100"}}
  ]}
}
