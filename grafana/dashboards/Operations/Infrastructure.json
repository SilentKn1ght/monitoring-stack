{
  "title": "Infrastructure",
  "uid": "infrastructure-overview",
  "tags": ["infrastructure", "operations"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "description": "Host-level infrastructure: CPU, memory, disk, network, Docker summary, capacity forecasting.",
  "panels": [
    {
      "id": 1, "title": "Host Overview", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2, "title": "CPU Usage", "type": "gauge",
      "gridPos": {"h": 6, "w": 3, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "instance:node_cpu_utilization:rate5m * 100", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 75}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 3, "title": "Memory Usage", "type": "gauge",
      "gridPos": {"h": 6, "w": 3, "x": 3, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 95}]}}}
    },
    {
      "id": 4, "title": "Disk Usage", "type": "gauge",
      "gridPos": {"h": 6, "w": 3, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"})) * 100", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 95}]}}}
    },
    {
      "id": 5, "title": "Swap Usage", "type": "gauge",
      "gridPos": {"h": 6, "w": 3, "x": 9, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "((node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / node_memory_SwapTotal_bytes) * 100", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 80}]}}}
    },
    {
      "id": 6, "title": "System Load", "type": "stat",
      "gridPos": {"h": 6, "w": 3, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "node_load15", "legendFormat": "15m", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 4}]}}}
    },
    {
      "id": 7, "title": "Uptime", "type": "stat",
      "gridPos": {"h": 6, "w": 3, "x": 15, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "time() - node_boot_time_seconds", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 8, "title": "Running Processes", "type": "stat",
      "gridPos": {"h": 6, "w": 3, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "node_procs_running", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 9, "title": "OOM Events", "type": "stat",
      "gridPos": {"h": 6, "w": 3, "x": 21, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(node_vmstat_oom_kill[1h])", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 10, "title": "CPU & Memory Trend", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7},
      "panels": []
    },
    {
      "id": 11, "title": "CPU Usage (7d)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 12, "title": "Memory Usage (7d)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 13, "title": "Disk Capacity Forecast", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"}", "legendFormat": "Available", "refId": "A"},
        {"expr": "predict_linear(node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"}[30d], 86400 * 30)", "legendFormat": "Forecast (30d)", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 14, "title": "Network Total (7d)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[$__rate_interval])", "legendFormat": "RX {{device}}", "refId": "A"},
        {"expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[$__rate_interval])", "legendFormat": "TX {{device}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 15, "title": "I/O & Disk", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 16},
      "panels": []
    },
    {
      "id": 16, "title": "Disk I/O", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total[$__rate_interval])", "legendFormat": "Read {{device}}", "refId": "A"},
        {"expr": "rate(node_disk_written_bytes_total[$__rate_interval])", "legendFormat": "Write {{device}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 17, "title": "Filesystem Usage", "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"} - node_filesystem_free_bytes{fstype!~\"tmpfs|overlay|squashfs\"}", "format": "table", "instant": true, "refId": "A"}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"__name__": true, "device": true, "instance": true, "job": true, "service": true}}}]
    },
    {
      "id": 18, "title": "Saturation - Pressure Stall", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 17},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "avg(node_pressure_cpu_waiting_seconds_total[$__rate_interval]) * 100", "legendFormat": "CPU Pressure %", "refId": "A"},
        {"expr": "avg(node_pressure_memory_waiting_seconds_total[$__rate_interval]) * 100", "legendFormat": "Memory Pressure %", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 19, "title": "Process & Container Restarts", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 25},
      "panels": []
    },
    {
      "id": 20, "title": "Container Restart Count", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 26},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "increase(process_open_fds{job=\"applications\"}[$__range])", "legendFormat": "{{service}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "displayName": "FDs"}}
    },
    {
      "id": 21, "title": "Process Uptime (by service)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 26},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "time() - process_start_time_seconds{job=\"applications\"}", "legendFormat": "{{service}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ],
  "templating": {"list": [
    {"name": "instance", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "query": "label_values(up{job=\"node-exporter\"}, instance)", "multi": false, "includeAll": false,
     "current": {"text": "node-exporter:9100", "value": "node-exporter:9100"}}
  ]},
  "links": [
    {"title": "Executive Overview", "type": "dashboards", "tags": ["operations"]},
    {"title": "Docker & Containers", "type": "dashboards", "tags": ["platform"]},
    {"title": "Node Exporter", "type": "dashboards", "tags": ["debug"]}
  ]
}
