{
  "title": "Logs & Incidents",
  "uid": "logs-and-incidents",
  "tags": ["logs", "operations"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "description": "Centralized log viewing, error tracking, noisy service detection, and incident response.",
  "panels": [
    {
      "id": 1, "title": "Log Volume & Errors", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2, "title": "Log Rate by Service", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum by(compose_service) (rate({job=\"docker\"}[5m]))", "legendFormat": "{{compose_service}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 3, "title": "Error Rate by Service", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "sum by(compose_service) (rate({job=\"docker\"} |= \"error\" or {job=\"docker\"} |= \"Error\" or {job=\"docker\"} |= \"ERROR\" [$__rate_interval]))", "legendFormat": "{{compose_service}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 4, "title": "Top Noisy Services (1h)", "type": "table",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "topk(10, sum by(compose_service) (count_over_time({job=\"docker\"}[1h])))", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "displayName": "Log Count"}}
    },
    {
      "id": 5, "title": "Common Exceptions", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "panels": []
    },
    {
      "id": 6, "title": "Top Error Patterns (1h)", "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "topk(10, sum by(pattern) (count_over_time({job=\"docker\"} | pattern \"<_>error<_>\" [1h])))", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 7, "title": "Auth Failures & Successes", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {"expr": "rate({job=\"auth\"} |= \"Failed password\" [$__rate_interval])", "legendFormat": "Failed", "refId": "A"},
        {"expr": "rate({job=\"auth\"} |= \"Accepted password\" [$__rate_interval])", "legendFormat": "Accepted", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 8, "title": "Live Log Viewer", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "panels": []
    },
    {
      "id": 9, "title": "Filtered Logs", "type": "logs",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 19},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{job=\"$job\"} |= \"$search\"", "refId": "A"}],
      "options": {"showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true}
    }
  ],
  "templating": {"list": [
    {"name": "job", "type": "query", "datasource": {"type": "loki", "uid": "loki"},
     "query": "label_values(job)", "multi": false, "includeAll": true,
     "current": {"text": "docker", "value": "docker"}},
    {"name": "search", "type": "textbox", "query": "", "current": {"text": "", "value": ""},
     "hide": 0, "label": "Search Filter"}
  ]},
  "links": [
    {"title": "Executive Overview", "type": "dashboards", "tags": ["operations"]},
    {"title": "Infrastructure", "type": "dashboards", "tags": ["infrastructure"]}
  ]
}
