{
  "title": "SiteLedger Operations",
  "uid": "siteledger-overview",
  "tags": ["siteledger", "operations"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "description": "SiteLedger application health, API performance, authentication, and business metrics.",
  "panels": [
    {
      "id": 1, "title": "Status", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2, "title": "API Health", "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_success{instance=\"https://app-nginx-1/api/health\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 3, "title": "API Latency", "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 4, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_duration_seconds{instance=\"https://app-nginx-1/api/health\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 4, "title": "Uptime", "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 8, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "time() - process_start_time_seconds{service=\"siteledger\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5, "title": "Active Sessions", "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "auth_active_sessions{service=\"siteledger\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 6, "title": "DB Connections", "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 16, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "pg_stat_database_numbackends{datname=\"construction_erp\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 7, "title": "Prisma Queries", "type": "stat",
      "gridPos": {"h": 5, "w": 4, "x": 20, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(prisma_query_count_total{service=\"siteledger\"}[5m])", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 8, "title": "API Performance", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "panels": []
    },
    {
      "id": 9, "title": "HTTP Request Rate", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(http_requests_total{service=\"siteledger\"}[$__rate_interval])", "legendFormat": "{{method}} {{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 10, "title": "HTTP Error Rate", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(http_requests_total{service=\"siteledger\",status=~\"5..\"}[$__rate_interval])", "legendFormat": "5xx {{route}}", "refId": "A"}, {"expr": "rate(http_requests_total{service=\"siteledger\",status=~\"4..\"}[$__rate_interval])", "legendFormat": "4xx {{route}}", "refId": "B"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 11, "title": "Request Duration (p95)", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"siteledger\"}[$__rate_interval])) by (le, route))", "legendFormat": "{{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 12, "title": "Business Activity", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15},
      "panels": []
    },
    {
      "id": 13, "title": "Database Queries", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(prisma_query_count_total{service=\"siteledger\"}[$__rate_interval])", "legendFormat": "{{action}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 14, "title": "Attendance Activity", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(business_attendance_total{service=\"siteledger\"}[$__rate_interval])", "legendFormat": "attendance", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 15, "title": "Active Sessions", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "auth_active_sessions{service=\"siteledger\"}", "legendFormat": "sessions", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "templating": {"list": [
    {"name": "hostname", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"},
     "query": "label_values(up, hostname)", "multi": false, "includeAll": false,
     "current": {"text": "vmi3410257", "value": "vmi3410257"}}
  ]},
  "links": [
    {"title": "Executive Overview", "type": "dashboards", "tags": ["operations"]},
    {"title": "PostgreSQL", "type": "dashboards", "tags": ["postgres", "debug"]}
  ]
}
