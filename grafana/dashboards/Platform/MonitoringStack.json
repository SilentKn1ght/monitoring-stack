{
  "title": "Monitoring Stack",
  "uid": "monitoring-stack",
  "tags": ["platform", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "time": {"from": "now-24h", "to": "now"},
  "refresh": "30s",
  "description": "Health of the monitoring infrastructure: Prometheus, Alertmanager, Loki, Grafana, exporters. For platform maintainers.",
  "panels": [
    {
      "id": 1, "title": "Service Health", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 2, "title": "Prometheus", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"prometheus\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 3, "title": "Alertmanager", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 3, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"internal-svc\",instance=\"http://alertmanager:9093/-/healthy\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 4, "title": "Loki", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"loki\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 5, "title": "Grafana", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 9, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_success{instance=\"https://app-nginx-1/grafana/api/health\"}", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}
    },
    {
      "id": 6, "title": "Targets Up", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(up == 1)", "legendFormat": "up", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 0}]}}}
    },
    {
      "id": 7, "title": "Targets Down", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 15, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(up == 0)", "legendFormat": "down", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 8, "title": "Scrape Failures", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(prometheus_target_scrapes_sample_out_of_order_total[$__rate_interval])", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 9, "title": "Firing Alerts", "type": "stat",
      "gridPos": {"h": 5, "w": 3, "x": 21, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "count(ALERTS{alertstate=\"firing\"})", "legendFormat": "", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}}
    },
    {
      "id": 10, "title": "Target Status", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6},
      "panels": []
    },
    {
      "id": 11, "title": "All Targets", "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up", "format": "table", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": [{"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "custom.displayMode", "value": "color-background-solid"}, {"id": "color", "value": {"mode": "thresholds"}}, {"id": "thresholds", "value": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}]}]}
    },
    {
      "id": 12, "title": "Scrape Duration by Job", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "scrape_duration_seconds", "legendFormat": "{{job}} {{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 13, "title": "Prometheus Storage", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 15},
      "panels": []
    },
    {
      "id": 14, "title": "TSDB Samples Appended", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(prometheus_tsdb_samples_appended_total[$__rate_interval])", "legendFormat": "samples/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 15, "title": "TSDB Storage", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "prometheus_tsdb_storage_blocks_bytes", "legendFormat": "Blocks", "refId": "A"},
        {"expr": "process_resident_memory_bytes{job=\"prometheus\"}", "legendFormat": "Memory", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 16, "title": "TSDB Series Count", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "prometheus_tsdb_head_series", "legendFormat": "Active Series", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 17, "title": "Rule Evaluations", "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "prometheus_evaluator_duration_seconds", "legendFormat": "{{rule_group}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 18, "title": "Alerting Pipeline", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 24},
      "panels": []
    },
    {
      "id": 19, "title": "Alert States", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "alertmanager_alerts", "legendFormat": "{{state}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "id": 20, "title": "Notification Failures", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(alertmanager_notifications_failed_total[$__rate_interval])", "legendFormat": "{{integration}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 21, "title": "Notifcations Total", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 25},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(alertmanager_notifications_total[$__rate_interval])", "legendFormat": "{{integration}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 22, "title": "Loki & Ingestion", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 33},
      "panels": []
    },
    {
      "id": 23, "title": "Loki Chunk Rate", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(loki_ingester_chunks_flushed_total[$__rate_interval])", "legendFormat": "chunks/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 24, "title": "Loki Ingest Rate", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(loki_distributor_bytes_received_total[$__rate_interval])", "legendFormat": "bytes/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 25, "title": "Loki Log Rate", "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 34},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rate(loki_distributor_lines_received_total[$__rate_interval])", "legendFormat": "lines/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    }
  ],
  "templating": {"list": []},
  "links": [
    {"title": "Infrastructure", "type": "dashboards", "tags": ["infrastructure"]},
    {"title": "Docker & Containers", "type": "dashboards", "tags": ["docker"]}
  ]
}
