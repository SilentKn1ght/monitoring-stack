{
  "title": "Cadvisor exporter",
  "uid": "pMEd7m0Mz",
  "tags": ["cadvisor", "docker"],
  "timezone": "",
  "schemaVersion": 38,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "description": "Simple exporter for cadvisor only",
  "panels": [
    {
      "id": 8, "title": "CPU", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 15, "title": "CPU Usage", "type": "timeseries",
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{instance=~\"$host\"}[5m])) * 100",
          "legendFormat": "Total CPU",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 11, "title": "Memory", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 8},
      "panels": []
    },
    {
      "id": 9, "title": "Memory Usage", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{instance=~\"$host\"}",
          "legendFormat": "Working Set",
          "refId": "A"
        },
        {
          "expr": "container_memory_rss{instance=~\"$host\"}",
          "legendFormat": "RSS",
          "refId": "B"
        },
        {
          "expr": "container_memory_cache{instance=~\"$host\"}",
          "legendFormat": "Cache",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 14, "title": "Memory Usage Breakdown", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "container_memory_usage_bytes{instance=~\"$host\"}",
          "legendFormat": "Total Usage",
          "refId": "A"
        },
        {
          "expr": "container_spec_memory_limit_bytes{instance=~\"$host\"}",
          "legendFormat": "Memory Limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 2, "title": "Network", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
      "panels": []
    },
    {
      "id": 4, "title": "Received Network Traffic", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{instance=~\"$host\"}[5m]))",
          "legendFormat": "Received",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 6, "title": "Sent Network Traffic", "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{instance=~\"$host\"}[5m]))",
          "legendFormat": "Sent",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 19, "title": "Misc", "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26},
      "panels": []
    },
    {
      "id": 17, "title": "Container Info", "type": "stat",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 27},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "expr": "time() - container_start_time_seconds{instance=~\"$host\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    }
  ],
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}},
    {"name": "host", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
     "query": "label_values(container_last_seen, instance)", "multi": false, "includeAll": true,
     "current": {"text": "cadvisor:8080", "value": "cadvisor:8080"}}
  ]}
}